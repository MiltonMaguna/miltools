  name EyeReflMetaData
  xpos -722
  ypos -2823
  addUserKnob {20 User}
  addUserKnob {6 mblurEnabled l "Motion Blur Enabled" +STARTLINE}
  mblurEnabled {{"\[metadata exr/mb.motion_blur_enable]"}}
 }
 StickyNote {
  inputs 0
  name StickyNote2
  label "In case anyone is wondering about this part.\n\nI found that it seemed to run a little faster/smoother interactively, \nif I did the generic highlight using an expression \ninstead of using a round circular image. \nIt's a smoothstep plus a gaussian... \nwhich is roughly the same as what you're doing \nif you create a round feathered roto, \nthen blur it and add that onto the unblurred version.\n(Which is what we do to the refl image if one chooses that instead.)\n\nSeems to work?"
  note_font_size 12
  xpos -346
  ypos -805
 }
