 StickyNote {
  inputs 0
  name StickyNote1
  label "In case anyone is wondering about this part.\n\nI got the equation for the (unpolarized) reflectance here:\nhttps://en.wikipedia.org/wiki/Fresnel_equations\n\nAnd I'm dividing that by the specific value for straight-on reflection,\n so that the intensity at the front of the eye won't change, \nit will only affect reflections around the sides.\n\nSeems easiest?"
  note_font_size 12
  xpos -239
  ypos 639
 }
