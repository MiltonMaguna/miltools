#! C:/Program Files/Nuke10.0v3/nuke-10.0.3.dll -nx
version 10.0 v3
add_layer {eyeST eyeST.red eyeST.green eyeST.blue eyeST.alpha}
Gizmo {
 inputs 4
 onCreate "\nn = nuke.thisNode()\nn\['reflScale'].setRange(0.1,5)\nn\['reflScaleRt'].setRange(0.1,5)\nn\['highlightSizeLf'].setRange(0,1)\nn\['highlightSizeRt'].setRange(0,1)\nn\['sizeUVMask'].setRange(0,2)\nn\['sizeUVMaskRt'].setRange(0,2)\nn\['reflOcclBlur'].setRange(0,10)\nn\['reflOcclBlurRt'].setRange(0,10)\nn\['highlightSizeLf'].clearFlag(0x00000004)\nn\['highlightSizeRt'].clearFlag(0x00000004)\nn\['highlightOcclBlurLf'].setRange(0,10)\nn\['highlightOcclBlurRt'].setRange(0,10)\nn\['sizeUVMask'].clearFlag(0x00000004)\nn\['sizeUVMaskRt'].clearFlag(0x00000004)\nn\['reflOcclBlur'].clearFlag(0x00000004)\nn\['reflOcclBlurRt'].clearFlag(0x00000004)\nn\['realAmbocc'].clearFlag(0x00000004)\nn\['fakeAmbocc'].clearFlag(0x00000004)\nn\['realAmboccRt'].clearFlag(0x00000004)\nn\['fakeAmboccRt'].clearFlag(0x00000004)\n"
 knobChanged "\n\ndef averageVectors(a,b):\n    alist = \[]\n    blist = \[]\n    if (type(a) != list and type(b) !=list):\n        return (a+b)*0.5;\n    elif (type(a) != list and type(b) == list):  \n        for i in range (0,len(b)):\n            alist.append(a)\n        blist=b\n    elif (type(a) == list and type(b) != list):\n        for i in range (0,len(a)):\n            blist.append(b)\n        alist = a\n    else:\n        alist = a\n        blist = b\n    avg = \[]\n    for j in range (0,min(len(alist),len(blist))):\n        avg.append((alist\[j]+blist\[j])*0.5)\n    return avg;\n\ndef makeDepend(n,k,knob1='',knob2='',linker='',linkColorPanel=False):\n    if (n\[linker].value()):\n        if (k.name() == knob1):\n            n\[knob2].setValue(n\[knob1].value())\n        if (k.name() == knob2):\n            n\[knob1].setValue(n\[knob2].value())\n        if(linkColorPanel):\n            try:\n                if (k.name() == knob1+'_panelDropped'):\n                    n\[knob2+'_panelDropped'].setValue(n\[knob1+'_panelDropped'].value())\n                if (k.name() == knob2+'_panelDropped'):\n                    n\[knob1+'_panelDropped'].setValue(n\[knob2+'_panelDropped'].value())\n            except:\n                pass\n        if (k.name() == linker):\n            average = averageVectors(n\[knob1].value(),n\[knob2].value())\n            n\[knob1].setValue(average)\n            n\[knob2].setValue(average)\n            if(linkColorPanel):\n                try:\n                    panelMin = min(n\[knob1+'_panelDropped'].value(),n\[knob2+'_panelDropped'].value())\n                    n\[knob1+'_panelDropped'].setValue(panelMin)\n                    n\[knob2+'_panelDropped'].setValue(panelMin)\n                except:\n                    pass\n            \nn = nuke.thisNode()\nk = nuke.thisKnob()\n\nmakeDepend(n,k,'offsetS','offsetSRt','linkReflBasics')\nmakeDepend(n,k,'offsetT','offsetTRt','linkReflBasics')\nmakeDepend(n,k,'reflRotation','reflRotationRt','linkReflBasics')\nmakeDepend(n,k,'reflScale','reflScaleRt','linkReflBasics')\nmakeDepend(n,k,'blurCornealBulge','blurCornealBulgeRt','linkReflBasics')\n\nmakeDepend(n,k,'overallGrade','overallGradeRt','linkReflGain')\nmakeDepend(n,k,'gradeSclera','gradeScleraRt','linkReflGain')\nmakeDepend(n,k,'gradeIris','gradeIrisRt','linkReflGain')\nmakeDepend(n,k,'gradePupil','gradePupilRt','linkReflGain')\nmakeDepend(n,k,'gradeUVMask','gradeUVMaskRt','linkReflGain')\nmakeDepend(n,k,'sizeUVMask','sizeUVMaskRt','linkReflGain')\nmakeDepend(n,k,'softnessUVMask','softnessUVMaskRt','linkReflGain')\nmakeDepend(n,k,'reflOcclusion','reflOcclusionRt','linkReflGain')\nmakeDepend(n,k,'reflOcclBlur','reflOcclBlurRt','linkReflGain')\n\nmakeDepend(n,k,'highlightColorLf','highlightColorRt','linkHighlights')\nmakeDepend(n,k,'positionSLf','positionSRt','linkHighlights')\nmakeDepend(n,k,'positionTLf','positionTRt','linkHighlights')\nmakeDepend(n,k,'rotationLf','rotationRt','linkHighlights')\nmakeDepend(n,k,'highlightSizeLf','highlightSizeRt','linkHighlights')\nmakeDepend(n,k,'highlightSoftnessLf','highlightSoftnessRt','linkHighlights')\nmakeDepend(n,k,'highlightOcclusionLf','highlightOcclusionRt','linkHighlights')\nmakeDepend(n,k,'highlightOcclBlurLf','highlightOcclBlurRt','linkHighlights')\n\nmakeDepend(n,k,'causticsColorLf','causticsColorRt','linkCaustics')\nmakeDepend(n,k,'offsetXLf','offsetXRt','linkCaustics')\nmakeDepend(n,k,'offsetYLf','offsetYRt','linkCaustics')\nmakeDepend(n,k,'causticsBlurLf','causticsBlurRt','linkCaustics')\n\nmakeDepend(n,k,'overallEyeGain','overallEyeGainRt','linkCC')\nmakeDepend(n,k,'scleraGain','scleraGainRt','linkCC')\nmakeDepend(n,k,'irisGain','irisGainRt','linkCC')\nmakeDepend(n,k,'pupilGain','pupilGainRt','linkCC')\nmakeDepend(n,k,'realAmbocc','realAmboccRt','linkCC')\nmakeDepend(n,k,'fakeAmbocc','fakeAmboccRt','linkCC')\nmakeDepend(n,k,'fakeAmboccWidth','fakeAmboccWidthRt','linkCC')\nmakeDepend(n,k,'blurEyeBorder','blurEyeBorderRt','linkCC')\n"
 tile_color 0xa7d300ff
 addUserKnob {20 Reflection l "Reflection Basics" t "Basic controls for ST-mapped eye reflections"}
 addUserKnob {26 eyeTool l "" t "Version 1, 5/21/2016 -- first attempt at this\nVersion 2, 6/05/2016 -- added highlight image, color correction, motion blur, lots of interface improvements\nVersion 3, 12/14/2016 -- added support for using meniscus only, and masking based on eye object UVs\nVersion 4, 3/03/2017 -- added support for monster eye ST AOVs, and per-eye color correction\nVersion 5, 3/25/2017 -- added per-eye control on nearly everything. May break existing eye setups :(" +STARTLINE T "Eye Reflection ST Map Tool, v5.0\n"}
 addUserKnob {41 eyeSTchannel l "eye ST channel" t "Use this to select which ST channel in the eyeRefl_layer to use. Default is \"eyeST,\" but you can change it to another ST AOV that accounts for one of the monsters' eye bump." T Shuffle_MONSTER.in}
 addUserKnob {4 meniscusOption l "" t "Use this to choose whether to use the whole eye including meniscus, or to handle the eye or meniscus by itself." +STARTLINE M {"use full eye including meniscus" "use meniscus only" "exclude meniscus" "" "" ""}}
 addUserKnob {6 applyHalfBugFix l "apply bug fix for halved ST's (only use if needed!)" t "There is a bug which I (Arun) haven't tracked down yet, in which eyeST AOVs come out half as bright as they should be... which of course messes up the coordinate mapping.\nUntil I can figure out how to even reproduce this... check this box if this happens to you. You will know it if you see values of 0.5 in the blue channel of your eyeST AOV channel(s).\nSorry." +STARTLINE}
 addUserKnob {26 topspace l "" +STARTLINE T " "}
 addUserKnob {6 addToBaseLayer l "add reflection + highlights + caustics to base layer" t "Output eye-color-corrected base layer + reflection + highlights + fake caustics \n(if checked off,  just output reflection + highlights + fake caustics)" +STARTLINE}
 addToBaseLayer true
 addUserKnob {6 antiAlias l "add extra antialiasing to reflection + highlights + caustics" t "Check this if you experience too much aliasing in the reflection, for example around the meniscus area." +STARTLINE}
