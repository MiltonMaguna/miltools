Gizmo {
 inputs 3
 tile_color 0xcccccc00
 addUserKnob {20 z_channel}
 addUserKnob {26 z_channel_v61 l z_channel_v6.1 -STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {26 reformat l Reformat}
 addUserKnob {41 disable_4 l Off T Reformat1.disable}
 addUserKnob {41 format l "output format" T Reformat1.format}
 addUserKnob {41 resize l "resize type" T Reformat1.resize}
 addUserKnob {20 depth l Depth}
 addUserKnob {6 znorm l Depth=1/z t "Invert the depth if your input is Nuke ScanlineRender style 1/Z" +STARTLINE}
 znorm true
 addUserKnob {6 hard l "Disable Hard Edges" -STARTLINE}
 hard true
 addUserKnob {26 zedge l "Edge Extend"}
 addUserKnob {6 disable_5 l Disable +STARTLINE}
 addUserKnob {41 growTexture l "Edge Extend" T colourEdge1.growTexture}
 addUserKnob {41 blurGrain l "Edge Blur" T colourEdge1.blurGrain}
 addUserKnob {41 shrinkMatte l "Shrink Matte" T colourEdge1.shrinkMatte}
 addUserKnob {41 alphaToWhite l "Alpha To White" T colourEdge1.alphaToWhite}
