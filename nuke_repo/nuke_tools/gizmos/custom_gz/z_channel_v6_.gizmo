 addUserKnob {26 "" -STARTLINE T "             "}
 addUserKnob {41 invertMatte l "Invert Matte" -STARTLINE T colourEdge1.invertMatte}
 addUserKnob {26 ""}
 addUserKnob {26 ShowZdepth}
 addUserKnob {41 disable_3 l "Show ZDepth" T Switch1.disable}
 addUserKnob {41 value l "Multiply zDepth" T Multiply1.value}
 addUserKnob {20 mb l "Motion Blur"}
 addUserKnob {41 disable_2 l "Disable MB" T VectorBlur3.disable}
 addUserKnob {41 disable_1 l "Invert MB Channel" -STARTLINE T SwitchMB.disable}
 addUserKnob {41 mv_presets l "mv presets" T VectorBlur3.mv_presets}
 addUserKnob {41 blur_uv l "blur uv" T VectorBlur3.blur_uv}
