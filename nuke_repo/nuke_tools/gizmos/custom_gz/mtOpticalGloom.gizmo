Group {
 name mtOpticalGloom
 inputs 3
 tile_color 0xffbf00ff
 note_font "Verdana Bold"
 note_font_size 12
 addUserKnob {20 User l mtOpticalGloom}
 addUserKnob {41 useGPUIfAvailable l "Use GPU if available" T AchoPijo.useGPUIfAvailable}
 addUserKnob {41 vectorize l "Vectorize on CPU" -STARTLINE T AchoPijo.vectorize}
 addUserKnob {41 channels T Convolve2.channels}
 addUserKnob {26 spaceFirst l " " T "  "}
 addUserKnob {4 modeConvolution l Mode M {pings diffusion ""}}
 addUserKnob {6 effectonly l "effect only" -STARTLINE}
 addUserKnob {6 fixBbox l fixBBox t "you need to have the bbox covering the full resolution. Check this to autocrop the src input and correctly apply the effect" -STARTLINE}
 addUserKnob {7 power l Power R 0.01 2}
 power 0.5
 addUserKnob {7 lumaBlack l Tolerance t "Only works with Ping mode"}
 lumaBlack 0.5
 addUserKnob {7 lumaWhite l "src White " t "Only works with ping mode"}
 lumaWhite 1
 addUserKnob {26 space07 l " " T " "}
 addUserKnob {41 "waveDispersion_Dispersion mult" l "Dispersion mult" T "AchoPijo.waveDispersion_Dispersion mult"}
 addUserKnob {7 dispsat l "Dispersion sat" R 0.1 3}
 dispsat 1
 addUserKnob {7 postblur l "post blur" R 0 5}
 addUserKnob {26 space01 l " " T " "}
 addUserKnob {26 text l "Diaphragm Options"}
 addUserKnob {26 space02 l " " T " "}
 addUserKnob {4 pulldownMode l Mode M {regular absolute negative ""}}
 pulldownMode absolute
 addUserKnob {6 showkernel l "show kernel" -STARTLINE}
 addUserKnob {26 space04_1 l " " T " "}
 addUserKnob {4 filterType l filter M {bladed disc "" "" ""}}
 addUserKnob {7 double l "aspect Ratio"}
 double 1.5
 addUserKnob {3 double_1 l blades}
 double_1 5
 addUserKnob {7 double_2 l roundness}
 double_2 0.2
 addUserKnob {7 double_4 l "inner size"}
 double_4 0.8
 addUserKnob {7 double_5 l "inner feather"}
 double_5 1
 addUserKnob {7 double_6 l "inner brightness"}
 double_6 0.5
 addUserKnob {26 space03 l " " T " "}
 addUserKnob {7 double_7 l "pre scale" R 0.01 1.1}
 double_7 1
 addUserKnob {7 double_12 l variation R 0 10}
 addUserKnob {7 double_11 l "var scale" R 2 300}
 double_11 100
 addUserKnob {7 double_8 l "var mix"}
 addUserKnob {26 ""}
 addUserKnob {26 space04 l " " T ""}
 addUserKnob {7 double_9 l "post scale" R 0.1 2}
 double_9 1
 addUserKnob {7 double_10 l "post rotation" R 0 360}
 addUserKnob {26 space50 l " " T " "}
 addUserKnob {26 ""}
 addUserKnob {7 mixOptical l mix}
 mixOptical 1
 addUserKnob {20 info}
 addUserKnob {26 infoText l " " T "mtOpticalGloom v1.1 - Miguel Torija"}
 addUserKnob {26 text_2 l " " T " "}
 addUserKnob {26 text_1 l " " T "Use it to create nice cool pings-glints or some soft diffusion on a more realistic way.\n\n"}
 addUserKnob {26 text_4 l "  " T "Modify your own Diaphragm or use an alternative one\nto replicate (the tool its not totally physically acurate) \nthe gloom effect that would happend throught it."}
 addUserKnob {26 text_5 l " " T " "}
 addUserKnob {26 text_3 l " " T "- I recommend using very low values on mix when using the diffusion mode.\n\n- It could be kind of slow, consider using the effect only checkbox,\nprecomp after and merge it with a plus.\n\n- When using altDiaphragm, try to use square formats, such as 1024x1024."}
}
