  KernelDescription "2 \"waveDispersion\" iterate pixelWise 9df64090b3a32a0be4712f814698ec8c3e5c2e05f6c0b38a09361b6a2e2c818f 10 \"src\" Read Random \"srcV\" Read Random \"srcB\" Read Random \"srcC\" Read Random \"srcG\" Read Random \"srcY\" Read Random \"srcO\" Read Random \"srcR\" Read Random \"STMap\" Read Point \"dst\" Write Point 2 \"count\" Int 1 DwAAAA== \"Dispersion mult\" Float 1 AACAPw== 2 \"count\" 1 1 \"multiplier\" 1 1 42 \"srcconstEdgeColor\" Float 4 1 AAAAAAAAAAAAAAAAAAAAAA== \"srcVconstEdgeColor\" Float 4 1 AAAAAAAAAAAAAAAAAAAAAA== \"srcBconstEdgeColor\" Float 4 1 AAAAAAAAAAAAAAAAAAAAAA== \"srcCconstEdgeColor\" Float 4 1 AAAAAAAAAAAAAAAAAAAAAA== \"srcGconstEdgeColor\" Float 4 1 AAAAAAAAAAAAAAAAAAAAAA== \"srcYconstEdgeColor\" Float 4 1 AAAAAAAAAAAAAAAAAAAAAA== \"srcOconstEdgeColor\" Float 4 1 AAAAAAAAAAAAAAAAAAAAAA== \"srcRconstEdgeColor\" Float 4 1 AAAAAAAAAAAAAAAAAAAAAA== \"resolution\" Int 2 1 AAAAAAAAAAA= \"outputFinal\" Float 4 1 AAAAAAAAAAAAAAAAAAAAAA== \"outputViolet\" Float 4 1 AAAAAAAAAAAAAAAAAAAAAA== \"outputBlue\" Float 4 1 AAAAAAAAAAAAAAAAAAAAAA== \"outputCyan\" Float 4 1 AAAAAAAAAAAAAAAAAAAAAA== \"outputGreen\" Float 4 1 AAAAAAAAAAAAAAAAAAAAAA== \"outputYellow\" Float 4 1 AAAAAAAAAAAAAAAAAAAAAA== \"outputOrange\" Float 4 1 AAAAAAAAAAAAAAAAAAAAAA== \"outputRed\" Float 4 1 AAAAAAAAAAAAAAAAAAAAAA== \"rainbow\" Float 4 1 AAAAAAAAAAAAAAAAAAAAAA== \"UV\" Float 2 1 AAAAAAAAAAA= \"UVoffset\" Float 2 1 AAAAAAAAAAA= \"UVout\" Float 2 1 AAAAAAAAAAA= \"UVviolet\" Float 2 1 AAAAAAAAAAA= \"UVblue\" Float 2 1 AAAAAAAAAAA= \"UVcyan\" Float 2 1 AAAAAAAAAAA= \"UVgreen\" Float 2 1 AAAAAAAAAAA= \"UVyellow\" Float 2 1 AAAAAAAAAAA= \"UVorange\" Float 2 1 AAAAAAAAAAA= \"UVred\" Float 2 1 AAAAAAAAAAA= \"violetRef\" Float 1 1 AAAAAA== \"blueRef\" Float 1 1 AAAAAA== \"cyanRef\" Float 1 1 AAAAAA== \"greenRef\" Float 1 1 AAAAAA== \"yellowRef\" Float 1 1 AAAAAA== \"orangeRef\" Float 1 1 AAAAAA== \"redRef\" Float 1 1 AAAAAA== \"violetScale\" Float 1 1 AAAAAA== \"blueScale\" Float 1 1 AAAAAA== \"cyanScale\" Float 1 1 AAAAAA== \"greenScale\" Float 1 1 AAAAAA== \"yellowScale\" Float 1 1 AAAAAA== \"orangeScale\" Float 1 1 AAAAAA== \"redScale\" Float 1 1 AAAAAA=="
  kernelSource "kernel waveDispersion : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessRandom, eEdgeConstant> src; // the input image\n  Image<eRead, eAccessRandom, eEdgeConstant> srcV; // the input image\n  Image<eRead, eAccessRandom, eEdgeConstant> srcB; // the input image\n  Image<eRead, eAccessRandom, eEdgeConstant> srcC; // the input image\n  Image<eRead, eAccessRandom, eEdgeConstant> srcG; // the input image\n  Image<eRead, eAccessRandom, eEdgeConstant> srcY; // the input image\n  Image<eRead, eAccessRandom, eEdgeConstant> srcO; // the input image\n  Image<eRead, eAccessRandom, eEdgeConstant> srcR; // the input image\n\n  Image<eRead, eAccessPoint, eEdgeClamped> STMap;\n\n \n  Image<eWrite> dst; // the output image\n\n  param:\n    // This parameter is made available to the user.\n       \n    int count;\n    float multiplier;\n\n\n  local:\n    // This local variable is not exposed to the user.\n\n    int2 resolution;\n\n    float4 outputFinal;\n\n    float4 outputViolet;\n    float4 outputBlue;\n    float4 outputCyan;\n    float4 outputGreen;\n    float4 outputYellow;\n    float4 outputOrange;\n    float4 outputRed;\n\n    float4 rainbow;\n\n    float2 UV;\n    float2 UVoffset;\n    float2 UVout;\n\n    float2 UVviolet;\n    float2 UVblue;\n    float2 UVcyan;\n    float2 UVgreen;\n    float2 UVyellow;\n    float2 UVorange;\n    float2 UVred;\n\n    // Refractive Index.\n    float violetRef;\n    float blueRef;\n    float cyanRef;\n    float greenRef;\n    float yellowRef;\n    float orangeRef;\n    float redRef;\n\n    // Refractive scaling.\n    float violetScale;\n    float blueScale;\n    float cyanScale;\n    float greenScale;\n    float yellowScale;\n    float orangeScale;\n    float redScale;\n\n\n  // In define(), parameters can be given labels and default values.\n  void define() \{\n    defineParam(count, \"count\", 15);\n    defineParam(multiplier, \"Dispersion mult\", 1.0f); \n  \}\n\n  // The init() function is run before any calls to process().\n  // Local variables can be initialized here.\n  void init() \{\n   \n    resolution.x = src.bounds.width();\n    resolution.y = src.bounds.height();\n\n    rainbow = 7.00f;\n    violetRef = 2.00f;\n    blueRef = 1.68f;\n    cyanRef = 1.51f;\n    greenRef = 1.37f;\n    yellowRef = 1.28f;\n    orangeRef = 1.22f;\n    redRef = 1.00f;\n\n  \}\n\n  void process(int2 pos) \{\n\n\n    UV.x = STMap().x ;\n    UV.y = STMap().y ;\n\n    UVoffset.x = STMap().x - 0.5f;\n    UVoffset.y = STMap().y - 0.5f;\n\n    // Refractive scaling.\n    float violetScale = violetRef * multiplier;\n    float blueScale  = blueRef * multiplier;\n    float cyanScale  = cyanRef * multiplier;\n    float greenScale  = greenRef * multiplier;\n    float yellowScale  = yellowRef * multiplier;\n    float orangeScale  = orangeRef * multiplier;\n    float redScale  = redRef * multiplier;\n\n    for(int i = 0; i < count; i++)\{\n\n\n      UVviolet.x = ((UV.x+ (( (UVoffset.x / violetScale)+0.5f)-UV.x)*(float(i)/count)  )    *resolution.x-.5f);\n      UVviolet.y = ((UV.y+ (( (UVoffset.y / violetScale)+0.5f )-UV.y)*(float(i)/count)  )    *resolution.y-.5f);\n\n      outputViolet += bilinear(srcV, UVviolet.x, UVviolet.y);\n\n    \}\n\n    outputViolet = outputViolet/count;\n\n    for(int i = 0; i < count; i++)\{\n\n\n      UVblue.x = ((UV.x+ (( (UVoffset.x / blueScale)+0.5f)-UV.x)*(float(i)/count)  )    *resolution.x-.5f);\n      UVblue.y = ((UV.y+ (( (UVoffset.y / blueScale)+0.5f )-UV.y)*(float(i)/count)  )    *resolution.y-.5f);\n\n      outputBlue += bilinear(srcB, UVblue.x, UVblue.y);\n\n    \}\n\n    outputBlue = outputBlue/count;\n\n    for(int i = 0; i < count; i++)\{\n\n\n      UVcyan.x = ((UV.x+ (( (UVoffset.x / cyanScale)+0.5f)-UV.x)*(float(i)/count)  )    *resolution.x-.5f);\n      UVcyan.y = ((UV.y+ (( (UVoffset.y / cyanScale)+0.5f )-UV.y)*(float(i)/count)  )    *resolution.y-.5f);\n\n      outputCyan += bilinear(srcC, UVcyan.x, UVcyan.y);\n\n    \}\n\n    outputCyan = outputCyan/count;\n\n    for(int i = 0; i < count; i++)\{\n\n\n      UVgreen.x = ((UV.x+ (( (UVoffset.x / greenScale)+0.5f)-UV.x)*(float(i)/count)  )    *resolution.x-.5f);\n      UVgreen.y = ((UV.y+ (( (UVoffset.y / greenScale)+0.5f )-UV.y)*(float(i)/count)  )    *resolution.y-.5f);\n\n      outputGreen += bilinear(srcG, UVgreen.x, UVgreen.y);\n\n    \}\n\n    outputGreen = outputGreen/count;\n\n    for(int i = 0; i < count; i++)\{\n\n\n      UVyellow.x = ((UV.x+ (( (UVoffset.x / yellowScale)+0.5f)-UV.x)*(float(i)/count)  )    *resolution.x-.5f);\n      UVyellow.y = ((UV.y+ (( (UVoffset.y / yellowScale)+0.5f )-UV.y)*(float(i)/count)  )    *resolution.y-.5f);\n\n      outputYellow += bilinear(srcY, UVyellow.x, UVyellow.y);\n\n    \}\n\n    outputYellow = outputYellow/count;\n     \n    for(int i = 0; i < count; i++)\{\n\n\n      UVorange.x = ((UV.x+ (( (UVoffset.x / orangeScale)+0.5f)-UV.x)*(float(i)/count)  )    *resolution.x-.5f);\n      UVorange.y = ((UV.y+ (( (UVoffset.y / orangeScale)+0.5f )-UV.y)*(float(i)/count)  )    *resolution.y-.5f);\n\n      outputOrange += bilinear(srcO, UVorange.x, UVorange.y);\n\n    \}\n\n    outputOrange = outputOrange/count;\n\n    for(int i = 0; i < count; i++)\{\n\n\n      UVred.x = ((UV.x+ (( (UVoffset.x / redScale)+0.5f)-UV.x)*(float(i)/count)  )    *resolution.x-.5f);\n      UVred.y = ((UV.y+ (( (UVoffset.y / redScale)+0.5f )-UV.y)*(float(i)/count)  )    *resolution.y-.5f);\n\n      outputRed += bilinear(srcR, UVred.x, UVred.y);\n\n    \}\n\n    outputRed = outputRed/count;\n\n    outputFinal = ((outputViolet + outputBlue + outputCyan +outputYellow + outputOrange + outputRed)/rainbow);\n\n    // Write the result to the output image\n\n\n    dst() = outputFinal;\n  \}\n\};"
  rebuild ""
  "waveDispersion_Dispersion mult" 0.5
  rebuild_finalise ""
