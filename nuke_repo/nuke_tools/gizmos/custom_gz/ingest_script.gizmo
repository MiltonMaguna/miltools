set cut_paste_input [stack 0]
version 15.1 v9
push $cut_paste_input
NoOp {
 name ingest_script
 tile_color 0x2167ff
 note_font "Verdana Bold"
 note_font_size 20
 selected true
 xpos -997
 ypos 110
 hide_input true
 addUserKnob {20 User}
 addUserKnob {22 run_ingest T "from UserTools.user_tools.libs.export_footage import run\nrun()" +STARTLINE}
}
