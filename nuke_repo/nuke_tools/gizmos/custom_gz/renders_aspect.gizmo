#! C:/Program Files/Nuke15.1v9/nuke-15.1.9.dll -nx
version 15.1 v9
Gizmo {
 tile_color 0xffbe00ff
 label "aspect = 19:6\naspect = 4:5\naspect = 9:16"
 addUserKnob {20 User}
 addUserKnob {41 disable_16_9 l Disable_16_9 T Write_169.disable}
 addUserKnob {41 disable_4_5 l Disable_4_5 T Write_45.disable}
 addUserKnob {41 disable_9_16 l Disable_9_16 T Write_916.disable}
 addUserKnob {26 "" +STARTLINE}
 addUserKnob {22 Render T "# get data Read, filename and first and last frame\nn = nuke.thisNode()\nnode_input = n.input(0)\n\nif node_input.Class() == 'Read':\n    \n    file = node_input.knob(\"file\").value()\n    frames = \[\[int(node_input.knob('first').getValue()), int(node_input.knob('last').getValue()), 1]]\n\n    # name\n    dir_path, file_name = os.path.split(file)\n    file_name, _ = os.path.splitext(file_name)\n\n    parts = file_name.split('_')\n    if not len(parts) > 1:\n        name = parts\[0]\n    name = '_'.join(parts\[:2])\n\n    # extension\n    ext = 'mov'\n    # fps\n    fps = int(nuke.root().fps())\n\n    # loop inside group\n    n.begin()\n\n    nodes_render = \[]\n    for node in nuke.allNodes():\n        if node.Class() == 'Write':\n\n            aspect = node.knob('aspect').getValue()\n            filename = (os.path.join(dir_path, f'\{name\}_\{aspect\}.\{ext\}')).replace('\\\\', '/')\n            \n            # knob\n            node.knob('file').setValue(filename)\n            node.knob('mov64_fps').setValue(fps)\n\n            if int(node.knob(\"disable\").getValue()):\n                print(f'NOT RENDER \{node.knob(\"name\").getValue()\}')\n                continue\n\n            nodes_render.append(node)\n\n    nuke.executeMultiple((tuple(nodes_render)), frames)\nelse:\n    nuke.message(\"Connect input directly to Read\")" +STARTLINE}
 addUserKnob {26 version l "" +STARTLINE T "renders aspect v001"}
}
 Input {
  inputs 0
  name Input1
  xpos -916
  ypos -443
 }
 NoOp {
  name data_write
  xpos -916
  ypos -374
  addUserKnob {20 User}
  addUserKnob {26 enable}
  addUserKnob {6 format_16_9 +STARTLINE}
  addUserKnob {6 format_9_16 +STARTLINE}
  addUserKnob {6 format_4_5 +STARTLINE}
  addUserKnob {3 first_frame}
  addUserKnob {3 last_frame -STARTLINE}
  addUserKnob {22 python_button T "n = nuke.thisNode()\nfile = n.input(0).knob(\"file\").value()" +STARTLINE}
  addUserKnob {20 custom_name}
  addUserKnob {1 format_169}
  format_169 _169
  addUserKnob {1 format_45}
  format_45 _45
  addUserKnob {1 format_916}
  format_916 _916
 }
