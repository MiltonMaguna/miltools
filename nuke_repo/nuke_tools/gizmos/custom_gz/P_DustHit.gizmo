push 0
 ParticleEmitter {
  inputs 3
  rate {{"frame >= \[value startFrame] && frame <= \[value startFrame] + \[value emitTime] ? \[value amount] : 0"}}
  lifetime {{life}}
  lifetime_variation 0.772
  velocity {{velocity_1}}
  velocity_variation 1
  size {{startSize}}
  mass_variation 0.722
  spread {{spread}}
  input_order "in order"
  start_frame_animation "in order"
  seed {{seed_1}}
  name ParticleEmitter2
  selected true
  xpos -435
  ypos 43
  addUserKnob {20 User}
  addUserKnob {7 velocity_1 l velocity}
  velocity_1 {{parent.dustHit_emitVelocity}}
  addUserKnob {7 life}
