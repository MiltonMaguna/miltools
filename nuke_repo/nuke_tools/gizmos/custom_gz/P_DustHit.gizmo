  startFrame {{parent.dustHit_startFrame}}
  addUserKnob {3 seed_1 l seed}
  seed_1 {{parent.dustHit_seed}}
  addUserKnob {7 startSize}
  startSize {{parent.dustHit_startSize}}
  addUserKnob {3 emitTime}
  emitTime {{parent.dustHit_emitTime}}
  addUserKnob {7 amount}
  amount {{parent.dustHit_emitRate}}
  addUserKnob {7 spread_1 l spread}
  spread_1 {{parent.dustHit_spread}}
 }
