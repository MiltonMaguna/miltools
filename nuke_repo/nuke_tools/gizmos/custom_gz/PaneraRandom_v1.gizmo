#! C:/Program Files/Nuke8.0v5/nuke-8.0.v5.dll -nx
version 8.0 v5
Gizmo {
help "Proyecta sobre una esfera y lo graba con otra camara, para simular la curvatura en un paneo, y anda bastaaaante bien. \n\nEl motion es con un vectorblur. Y el zoom es cambiando la distancia focal del lente, nada de andar moviendo la camara. "
note_font Verdana
mapsize {0.15 0.15}
addUserKnob {20 User l Panera}
addUserKnob {41 filmBackSizePresets l "Film Back Preset" T camarainfo.filmBackSizePresets}
addUserKnob {41 focal l "focal length" T CameraProject.focal}
addUserKnob {13 rotation}
addUserKnob {7 zom l Zoom t "Modifica la distancia focal del lente de la camara que graba" R -10 10}
addUserKnob {26 render l Render}
addUserKnob {41 filter T ScanlineRender1.filter}
addUserKnob {41 antialiasing T ScanlineRender1.antialiasing}
addUserKnob {6 mb_enable l "motion blur" +STARTLINE}
mb_enable true
addUserKnob {7 mb_amount t "el multiply del vectorblur" R 0 3}
mb_amount 0.5
addUserKnob {20 noisetab l Noise}
addUserKnob {41 filmBackSize l "Film Back Size" T camarainfo.filmBackSize}
addUserKnob {7 amp l "Amplitud general"}
amp 0.1
addUserKnob {3 seed l "Semilla (seed)"}
seed 20
addUserKnob {26 ""}
addUserKnob {7 velocity R 0 10}
velocity 0.5
addUserKnob {13 frequency l "freq individual"}
frequency {0.2 0.2 0}
addUserKnob {13 amp_ind l "amplitud individual"}
amp_ind {4 4 0}
addUserKnob {26 ""}
addUserKnob {7 velocity2 l "velocity 2" R 0 10}
velocity2 1
addUserKnob {13 frequency2 l "freq individual 2"}
frequency2 {0.2 0.2 0}
addUserKnob {13 amp_ind2 l "amplitud individual 2"}
amp_ind2 {1 1 0}
addUserKnob {26 ""}
addUserKnob {13 noise l Noise t "Output del calculo de la curva"}
noise {{amp*((random((frame+seed)*velocity*frequency.x)-.5)*amp_ind.x+(random((frame+seed)*velocity2*frequency2.x)-.5)*amp_ind2.x)} {amp*((random((frame+seed+1000)*velocity*frequency.y)-.5)*amp_ind.y+(random((frame+seed+1000)*velocity2*frequency2.y)-.5)*amp_ind2.y)} {amp*((random((frame+seed)*velocity*frequency.z)-.5)*amp_ind.z+(random((frame+seed)*velocity2*frequency2.z)-.5)*amp_ind2.z)}}
addUserKnob {20 LensDistortion}
addUserKnob {6 onLD l On -STARTLINE}
addUserKnob {7 overScan l "OverScan (LensDist)" R 0 50}
overScan 30
addUserKnob {26 ""}
addUserKnob {41 distortion1 l "Radial Distortion 1" T Undistort.distortion1}
addUserKnob {41 distortion2 l "Radial Distortion 2" T Undistort.distortion2}
}
Camera2 {
inputs 0
rotate {{parent.rotation.x+noise.x i} {parent.rotation.y+noise.y i} {parent.rotation.z+noise.z i}}
focal {{parent.CameraProject.focal+parent.zom i}}
haperture {{parent.camarainfo.filmBackSize.x i}}
vaperture {{parent.camarainfo.filmBackSize.y i}}
name CameraCapture
xpos -857
ypos 528
}
set N3002ebc0 [stack 0]
push $N3002ebc0
