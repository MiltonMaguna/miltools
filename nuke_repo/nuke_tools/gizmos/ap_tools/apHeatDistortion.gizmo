Gizmo {
 name apHeatDistortion
 inputs 2
 help "apHeatDistortion v1.3 by Adrian Pueyo\nadrianpueyo.com, 2016"
 addUserKnob {20 apHeatDistortion t "Create awesome heat distortion."}
 addUserKnob {41 channels T Remove1.channels}
 addUserKnob {41 size T HDistController.size}
 addUserKnob {41 strength T HDistController.strength}
 addUserKnob {41 speed T HDistController.speed}
 addUserKnob {41 wind T HDistController.wind}
 addUserKnob {41 complexity T HDistController.complexity}
 addUserKnob {4 alphaOutput l "alpha output" M {original "alpha input" "dispersion mask"}}
 addUserKnob {26 copyright l "" +STARTLINE T "\napHeatDistortion v1.3 - adrianpueyo.com, 2016"}
 addUserKnob {20 Dispersion}
 addUserKnob {41 activateDispersion l "activate dispersion" T HDistController.activateDispersion}
 addUserKnob {41 falloff T HDistController.falloff}
 addUserKnob {41 min T HDistController.min}
 addUserKnob {41 max T HDistController.max}
 addUserKnob {41 softness l soft T HDistController.softness}
}
 NoOp {
  inputs 0
  name HDistController
  xpos 230
  ypos 119
  addUserKnob {20 HDistController}
  addUserKnob {14 size t "Noise size." R 0 200}
  size 50
  addUserKnob {7 strength t "Amount of distortion to produce." R 0 100}
  strength 10
  addUserKnob {7 speed t "Speed of the noise vibration/evolution." R -50 50}
  speed 5
  addUserKnob {12 wind t "Moving speed of the heat distortion."}
  wind {0 0.5}
  addUserKnob {7 complexity t "0 means simple, 1 means complex."}
  complexity 0.5
  addUserKnob {20 Dispersion}
  addUserKnob {6 activateDispersion l "activate dispersion" t "Activate a dispersion effect through the Heat Distortion mask." +STARTLINE}
  addUserKnob {7 falloff R 0 4}
  falloff 1.5
  addUserKnob {7 min t "Minimum level of haze through the mask input."}
  addUserKnob {7 max t "Minimum level of haze through the mask input."}
  max 1
  addUserKnob {14 softness l soft t "Preblur of the noise mask before applying the dispersion." R 0 100}
  softness 15
 }
 Input {
  inputs 0
  name Inputmask
  xpos -420
  ypos -211
  number 1
 }
