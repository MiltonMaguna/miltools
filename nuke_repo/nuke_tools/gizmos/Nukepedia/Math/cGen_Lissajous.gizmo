### curveGens v1.2
### Nuke 4.5.27
###
version 4.5027
Gizmo {
 inputs 0
 tile_color 0xff800000
 label "@s-2 CurveGen"
 name Lissajous
 addUserKnob {20 "" User}
 addUserKnob {26 "" "@b;Lissajous"}
 addUserKnob {12 freq Frequency:}
 freq {7 5}
 addUserKnob {14 scale Scale:}
 scale 200
 addUserKnob {12 offset Offset:}
 offset {320 240}
 addUserKnob {7 fc "Frame Cycle:" R 1 1000}
 fc 90
 addUserKnob {7 velo Velocity R 0 10}
 velo 1.818
 addUserKnob {26 "" ""}
 addUserKnob {12 result Result:}
 result {{scale.w*cos(freq.x*frame*velo*acos(-1)/fc)+offset.x i} {scale.h*sin(freq.y*frame*velo*acos(-1)/fc)+offset.y}}
}
push 0
 NoOp {
  name NoOp1
  xpos 130
  ypos 62
 }
 Output {
  name Output1
  xpos 130
  ypos 88
 }
end_group
