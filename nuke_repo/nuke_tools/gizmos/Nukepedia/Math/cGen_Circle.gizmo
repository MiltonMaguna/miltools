version 4.5027
Gizmo {
 inputs 0
 tile_color 0xff800000
 label "@s-2 CurveGen"
 name Circle
 addUserKnob {20 "" User}
 addUserKnob {26 "" "@b;Circle"}
 addUserKnob {14 scale Scale:}
 scale 150
 addUserKnob {12 offset Offset:}
 offset {320 240}
 addUserKnob {7 fc "Frame Cycle:" R 0 1000}
 fc 90
 addUserKnob {7 velo Velocity: R 0 100}
 velo 2
 addUserKnob {3 time INVISIBLE}
 time {{frame*velo*acos(-1)/fc i}}
 addUserKnob {26 "" ""}
 addUserKnob {12 result Result:}
 result {{offset.x+scale.w*sin(time)} {offset.y+scale.h*cos(time)}}
}
push 0
 NoOp {
  name NoOp1
  selected true
  xpos 50
  ypos -91
 }
 Output {
  name Output1
  selected true
  xpos 50
  ypos -65
 }
end_group
