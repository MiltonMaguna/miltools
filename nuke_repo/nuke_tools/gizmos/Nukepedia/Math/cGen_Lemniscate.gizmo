version 4.5027
Gizmo {
 inputs 0
 tile_color 0xff800000
 label "@s-2 CurveGen"
 name Lemniscate
 addUserKnob {20 "" User}
 addUserKnob {26 "" "@b;Lemniscate"}
 addUserKnob {14 scale Scale:}
 scale {250 150}
 addUserKnob {12 offset Offset:}
 offset {320 240}
 addUserKnob {7 fc "Frame Cycle:" R 1 1000}
 fc 60
 addUserKnob {7 velo Velocity: R 0 10}
 velo 1.212
 addUserKnob {3 time INVISIBLE}
 time {{frame*velo*acos(-1)/fc i}}
 addUserKnob {26 "" ""}
 addUserKnob {12 result Result:}
 result {{scale.w*cos(time)/(1+sin(time)*sin(time))+offset.x} {(scale.h*sin(time)*2*cos(time))/(1+sin(time)*sin(time))+offset.y}}
}
push 0
 NoOp {
  name NoOp1
  xpos 130
  ypos 62
 }
 Output {
  name Output1
  xpos 130
  ypos 88
 }
end_group
