version 4.5027
Gizmo {
 inputs 0
 tile_color 0xff800000
 label "@s-2 CurveGen"
 name Random_SS
 addUserKnob {20 "" Settings}
 addUserKnob {26 "" "@b;Random State Switch"}
 addUserKnob {7 astate "A State:" R 0 1000}
 astate -1
 addUserKnob {7 bstate "B State:" R 0 1000}
 bstate 1
 addUserKnob {7 balance Balance: R 0 100}
 balance 25
 addUserKnob {7 space Spacing: R 0 100}
 space 100
 addUserKnob {26 "" ""}
 addUserKnob {7 result Result: R 0 1}
 result {{(random(frame)>(balance/space))?astate:bstate x35 0}}
}
push 0
 NoOp {
  name NoOp1
  xpos 19
  ypos 13
 }
 Output {
  name Output1
  xpos 19
  ypos 39
 }
end_group
