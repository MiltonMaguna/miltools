version 4.5027
Gizmo {
 inputs 0
 tile_color 0xff800000
 label "@s-2 CurveGen"
 name Rose
 addUserKnob {20 "" User}
 addUserKnob {26 "" "@b;Rose"}
 addUserKnob {7 loops Loops: R 1 10}
 loops 5
 addUserKnob {14 scale Scale:}
 scale 100
 addUserKnob {12 offset Offset:}
 offset {320 240}
 addUserKnob {7 fc "Frame Cycle:" R 1 1000}
 fc 60
 addUserKnob {3 time INVISIBLE}
 time {{frame*velo*acos(-1)/fc i}}
 addUserKnob {7 velo Velocity: R 0 10}
 velo 1.213
 addUserKnob {26 "" ""}
 addUserKnob {12 result Result:}
 result {{(cos(time)-cos((loops-1)*time))*scale.w+offset.x i} {(sin(time)+sin((loops-1)*time))*scale.h+offset.y}}
}
push 0
 NoOp {
  name NoOp1
  xpos 130
  ypos 62
 }
 Output {
  name Output1
  xpos 130
  ypos 88
 }
end_group
