#! /EDI/apps/64_bit/common/opt/Nuke6.0v6/Nuke6.0 -nx
version 6.0 v6
Gizmo {
 help "==========================================\nDenoise  v1.0       23_6_10\n==========================================\n\nIt works on YCbCr colorspace instead of RGB. It helps to soften digital artifact working with different parameters on: black dots, white dots an over coloured dots\n\n==========================================\n feel free to contact me at niccolo.barbero@gmail.com\n=========================================="
 addUserKnob {20 User}
 addUserKnob {26 DENOISE}
 addUserKnob {26 ""}
 addUserKnob {26 ""}
 addUserKnob {26 black_noise_removal}
 addUserKnob {41 size T w_d_m.size}
 addUserKnob {26 white_noise_removal}
 addUserKnob {41 size_1 l size T black_d_rem.size}
 addUserKnob {26 colored_noise_removal}
 addUserKnob {41 size_3 l size T c_n_rem1.size}
 addUserKnob {41 size_2 l size T color_nr.size}
}
