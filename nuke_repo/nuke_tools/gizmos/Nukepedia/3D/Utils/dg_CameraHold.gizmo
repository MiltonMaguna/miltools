  focal_point {{"\[python -execlocal n=nuke.thisGroup().input(0)\\nif\\ n:\\n\\ \\ \\ while\\ n.Class()==\\\"Dot\\\":\\n\\ \\ \\ \\ \\ \\ n=n.input(0)\\n\\ \\ \\ \\ \\ \\ if\\ not\\ n:\\n\\ \\ \\ \\ \\ \\ \\ \\ \\ break\\n\\ \\ \\ if\\ n:\\n\\ \\ \\ \\ \\ \\ ret\\ =\\ n.knob(nuke.thisKnob().name()).value()\\n\\ \\ \\ else:\\n\\ \\ \\ \\ \\ \\ ret\\ =\\ 0\\nelse:\\n\\ \\ \\ ret\\ =\\ 0]" i}}
  fstop {{"\[python -execlocal n=nuke.thisGroup().input(0)\\nif\\ n:\\n\\ \\ \\ while\\ n.Class()==\\\"Dot\\\":\\n\\ \\ \\ \\ \\ \\ n=n.input(0)\\n\\ \\ \\ \\ \\ \\ if\\ not\\ n:\\n\\ \\ \\ \\ \\ \\ \\ \\ \\ break\\n\\ \\ \\ if\\ n:\\n\\ \\ \\ \\ \\ \\ ret\\ =\\ n.knob(nuke.thisKnob().name()).value()\\n\\ \\ \\ else:\\n\\ \\ \\ \\ \\ \\ ret\\ =\\ 0\\nelse:\\n\\ \\ \\ ret\\ =\\ 0]" i}}
  name Camera2
  xpos 281
  ypos -22
  addUserKnob {20 User}
  addUserKnob {3 holdFrame}
  holdFrame 1
  addUserKnob {22 current -STARTLINE T "nuke.thisNode().knob(\"holdFrame\").setValue(nuke.frame())"}
 }
end_group
