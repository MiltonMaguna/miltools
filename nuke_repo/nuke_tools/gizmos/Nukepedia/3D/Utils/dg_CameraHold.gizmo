  far {{"\[python -execlocal n=nuke.thisGroup().input(0)\\nif\\ n:\\n\\ \\ \\ while\\ n.Class()==\\\"Dot\\\":\\n\\ \\ \\ \\ \\ \\ n=n.input(0)\\n\\ \\ \\ \\ \\ \\ if\\ not\\ n:\\n\\ \\ \\ \\ \\ \\ \\ \\ \\ break\\n\\ \\ \\ if\\ n:\\n\\ \\ \\ \\ \\ \\ ret\\ =\\ n.knob(nuke.thisKnob().name()).value()\\n\\ \\ \\ else:\\n\\ \\ \\ \\ \\ \\ ret\\ =\\ 0\\nelse:\\n\\ \\ \\ ret\\ =\\ 0]" i}}
