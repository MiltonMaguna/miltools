#! /Applications/Nuke6.2v2/NukeX6.2v2.app/../Nuke6.2v2.app/Contents/MacOS/Nuke6.2v2 -nx
version 6.2 v2
Gizmo {
 inputs 2
 addUserKnob {20 Grain_CB}
 addUserKnob {3 seed t "Change this value to make different instances of this operator produce different noise"}
 seed 134
 addUserKnob {35 presets -STARTLINE M {"presets/Kodak 5248" "knobs this \{gangSeed 0 rsize 3.30 gsize 2.90 bsize 2.5 redIr 0.60 greenIr 0.60 blueIr 0.60 redT 0.42 greenT 0.46 blueT 0.85 redSoft 0.5 greenSoft 0.5 blueSoft 0.5 bs 0 label \{Kodak 5248\}\}" "presets/Kodak 5279" "knobs this \{gangSeed 0 rsize 2.70 gsize 2.60 bsize 2.40 redIr 1.00 greenIr 0.76 blueIr 0.65 redT 0.37 greenT 0.60 blueT 1.65 redSoft 0.5 greenSoft 0.5 blueSoft 0.5 bs 0 label \{Kodak 5279\}\}" "presets/Kodak FX214" "knobs this \{gangSeed 0 rsize 1.87 gsize 2.60 bsize 2.44 redIr 1 greenIr 0.76 blueIr 0.79 redT 0.41 greenT 0.60 blueT 1.80 redSoft 0.5 greenSoft 0.5 blueSoft 0.5 bs 0 label \{Kodak FX214\}\}" "presets/Kodak GT5274" "knobs this \{gangSeed 0 rsize 0.04 gsize 0.10 bsize 0.90 redIr 0.90 greenIr 0.76 blueIr 0.81 redT 0.49 greenT 0.50 blueT 1.55 redSoft 0.5 greenSoft 0.5 blueSoft 0.5 bs 0 label \{Kodak GT5274\}\}" "presets/Kodak 5217" "knobs this \{gangSeed 0 rsize 0.23 gsize 1.20 bsize 1.40 redIr 0.60 greenIr 0.86 blueIr 0.60 redT 0.48 greenT 0.42 blueT 0.87 redSoft 0.5 greenSoft 0.5 blueSoft 0.5 bs 0 label \{Kodak 5217\}\}" "presets/Kodak 5218" "knobs this \{gangSeed 0 rsize 0.10 gsize 1.60 bsize 1.91 redIr 0.60 greenIr 0.86 blueIr 0.73 redT 0.38 greenT 0.17 blueT 0.87 redSoft 0.5 greenSoft 0.5 blueSoft 0.5 bs 0 label \{Kodak 5218\}\}" "presets/Kodak 5219" "knobs this \{gangSeed 0 rsize 1.2 gsize 1.4 bsize 1.3 redIr 1.2 greenIr 0.6 blueIr 0.9 redT 0.37 greenT 0.31 blueT 0.85 redSoft 0.5 greenSoft 0.5 blueSoft 0.5 bs \{-1 -0.8 0\} label \{Kodak 5219\}\}" "presets/Kodak 5201" "knobs this \{gangSeed 0 rsize 0.10 gsize 1 bsize 1 redIr 0.60 greenIr 0.86 blueIr 0.73 redT 0.2 greenT 0.24 blueT 0.47 redSoft 0.5 greenSoft 0.5 blueSoft 0.5 bs 0 label \{Kodak 5201\}\}" "presets/Kodak 5213" "knobs this \{gangSeed 0 rsize 0.6 gsize 0.8 bsize 1 redIr 0.7 greenIr 1 blueIr 0.3 redT 0.34 greenT 0.38 blueT 0.85 redSoft 0.5 greenSoft 0.5 blueSoft 0.5 bs \{-1 -1 -1.1\} label \{Kodak 5213\}\}" "presets/Kodak 5245" "knobs this \{gangSeed 0 rsize 1.5 gsize 1 bsize 1.3 redIr 0.60 greenIr 0.86 blueIr 3.43 redT 0.08 greenT 0.12 blueT 0.32 redSoft 0.5 greenSoft 0.5 blueSoft 0.5 bs \{0 -1.2 -1.15\} label \{Kodak 5245\}\}" "presets/Digital Noise" "knobs this \{gangSeed 1 rsize 1.7 gsize rsize bsize rsize redIr 0.30 greenIr redIr blueIr redIr redT 0.15 greenT 0.15 blueT 0.15 redSoft 0.5 greenSoft 0.5 blueSoft 0.5 bs 0 label \{Digital Noise\}\}" ""}}
 addUserKnob {26 version l "                     - " -STARTLINE T "by Chad Buehler           \nv1.7                     "}
 addUserKnob {32 bugs l " comments / bugs " t "click here to download the latest version, leave a comment/request or a bug." -STARTLINE T "start http://www.nukepedia.com/search/chad-buehler/"}
 addUserKnob {6 gangSeed l "gang seed" t "gangs the seed for Red, Green and Blue, so they're identical." +STARTLINE}
 addUserKnob {26 "" l "@b;Size"}
 addUserKnob {6 anamorphic t "Doubles the width grain size" +STARTLINE}
 addUserKnob {14 rsize l red R 0 100}
 rsize 3.3
 addUserKnob {14 gsize l green R 0 100}
 gsize 2.9
 addUserKnob {14 bsize l blue R 0 100}
 bsize 2.5
 addUserKnob {26 "" l "@b;Irregularity"}
 addUserKnob {7 redIr l red}
 redIr 0.6
 addUserKnob {7 greenIr l green}
 greenIr 0.6
 addUserKnob {7 blueIr l blue}
 blueIr 0.6
 addUserKnob {26 "" l "@b;Intensity"}
 addUserKnob {7 redT l red t "Amount of grain to add to a white pixel"}
 redT 0.42
 addUserKnob {7 greenT l green t "Amount of grain to add to a white pixel"}
 greenT 0.46
 addUserKnob {7 blueT l blue t "Amount of grain to add to a white pixel"}
 blueT 0.85
 addUserKnob {26 "" l "@b;Soften"}
 addUserKnob {7 redSoft l red t "Fine adjustments"}
 redSoft 0.5
 addUserKnob {7 greenSoft l green t "Fine adjustments"}
 greenSoft 0.5
 addUserKnob {7 blueSoft l blue t "Fine adjustments"}
 blueSoft 0.5
 addUserKnob {26 blurorsharpen l "@b;Blur or Sharpen"}
 addUserKnob {18 bs l RGB R -1 1}
 bs {0 0 0}
 addUserKnob {20 RangeGroup l "@b;Range (Film Response)" t "Allows you to set a range, based on the image values, where grain will and won't appear.  A value of 1 is full grain and 0 is no grain." n 1}
 RangeGroup 0
 addUserKnob {6 userange l "Use Range" t "This toggles range on/off" +STARTLINE}
 addUserKnob {6 LUM l Luminance t "Uses Luminance, instead of the individual RGB values to drive the key." -STARTLINE}
 addUserKnob {6 preview l "preview      " t "Allows you to see what the range looks like.  For preview purposes only.  Disable to use grain." -STARTLINE}
 addUserKnob {41 setP2 l "Master Only" t "Preset for using the Master LUT only" -STARTLINE T ColorLookup1.setP2}
 addUserKnob {41 setP1_1 l "RGB Separately" t "preset for using R, G & B separately" -STARTLINE T ColorLookup1.setP1}
 addUserKnob {26 ""}
 addUserKnob {41 lut_1 l "" -STARTLINE T ColorLookup1.lut}
 addUserKnob {20 endGroup n -1}
 addUserKnob {26 "" l "@b;Mask"}
 addUserKnob {41 maskChannelMask l "" +STARTLINE T Copy1.maskChannelMask}
 addUserKnob {41 inject -STARTLINE T Copy1.inject}
 addUserKnob {41 invert_mask l invert -STARTLINE T Copy1.invert_mask}
 addUserKnob {41 fringe -STARTLINE T Copy1.fringe}
 addUserKnob {20 sMasks l "Seperate masks per channel" t "This enables you to use different masks per channel.  This is handy when RGB has been distorted differently from one another." n 1}
 sMasks 0
 addUserKnob {6 rgbMasks l "Use seperate RGB masks" +STARTLINE}
 addUserKnob {41 maskChannelMask_1 l Red T Red.maskChannelMask}
 addUserKnob {41 inject_1 l inject -STARTLINE T Red.inject}
 addUserKnob {41 invert_mask_2 l invert -STARTLINE T Red.invert_mask}
 addUserKnob {41 fringe_1 l fringe -STARTLINE T Red.fringe}
 addUserKnob {41 maskChannelMask_2 l Green T Green.maskChannelMask}
 addUserKnob {41 inject_2 l inject -STARTLINE T Green.inject}
 addUserKnob {41 invert_mask_3 l invert -STARTLINE T Green.invert_mask}
 addUserKnob {41 fringe_2 l fringe -STARTLINE T Green.fringe}
 addUserKnob {41 maskChannelMask_3 l Blue T Blue.maskChannelMask}
 addUserKnob {41 inject_3 l inject -STARTLINE T Blue.inject}
 addUserKnob {41 invert_mask_4 l invert -STARTLINE T Blue.invert_mask}
 addUserKnob {41 fringe_3 l fringe -STARTLINE T Blue.fringe}
 addUserKnob {20 endGroup_1 l endGroup n -1}
 addUserKnob {26 "" l "@b;Mask Falloff"}
 addUserKnob {7 Igrain l "Increase Grain" t "Increasing this value brings in more grain on the less dense areas of the mask."}
 addUserKnob {26 ""}
 addUserKnob {41 mix T Copy1.mix}
 addUserKnob {20 BlackNoiseBoost l "Black Noise Boost"}
 addUserKnob {6 Useboost l "Use Boost" t "Boost the brightness of the grain in the low end.  Once you've set your key, to see any changes, you'll need to adjust the CC grain/Bright specs." +STARTLINE}
 addUserKnob {6 prevKey l "Preview Key" t "Allows you to see what the range looks like.  For preview purposes only.  Disable to use grain." -STARTLINE}
 addUserKnob {26 psets3 l presets}
 addUserKnob {41 setP2_1 l "Master Only" t "Preset for using the Master LUT only" T ColorLookup2.setP2}
 addUserKnob {41 setP1 l "RGB Separately" t "preset for using R, G & B separately" -STARTLINE T ColorLookup2.setP1}
 addUserKnob {26 "" l "@b;Key"}
 addUserKnob {41 lut l "" +STARTLINE T ColorLookup2.lut}
 addUserKnob {26 ccGrain l "@b;CC grain"}
 addUserKnob {18 times l multiply R 0 20}
 times {1 1 1}
 addUserKnob {18 GrOff l offset R -1 1}
 GrOff {0 0 0}
 addUserKnob {26 bgrain l "@b;Bright specs"}
 addUserKnob {6 UseSpecs l "Add specs to Boost" t "Use Boost must be on.  This adds the bright specs to the blue channel.  If you only want to use this - make sure the CC grain multiply is set to 1 and the offset is 0." +STARTLINE}
 addUserKnob {7 bspecs l blue t "Use Boost must be on.  This adds the bright little specs on on the blue channel." R 1 3}
 bspecs 2
 addUserKnob {20 LensDistortion l "Lens Distortion"}
 addUserKnob {6 UseSTMapDistortion l " Use STMap Distortion" t "UV style Distortion\nWhen you have to work on undistorted footage" +STARTLINE}
 addUserKnob {41 uv l "UV channels" T STMap1.uv}
 addUserKnob {41 blur l "blur channel" T STMap1.blur}
 addUserKnob {41 blur_scale l "blur scale" T STMap1.blur_scale}
 addUserKnob {41 maskChannel l "mask channel" T STMap1.maskChannel}
 addUserKnob {41 invert_mask_1 l invert -STARTLINE T STMap1.invert_mask}
 addUserKnob {41 premultiplied -STARTLINE T STMap1.premultiplied}
 addUserKnob {41 filter T STMap1.filter}
}
