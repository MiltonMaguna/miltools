 ColorMatrix {
  matrix {
      {1 0 0}
      {0 {cos(rotateX*pi/180)} {-sin(rotateX*pi/180)}}
      {0 {sin(rotateX*pi/180)} {cos(rotateX*pi/180)}}
    }
  name rotateX1
  xpos 334
  ypos 247
 }
 ColorMatrix {
  matrix {
      {{cos(rotateY*pi/180)} 0 {sin(rotateY*pi/180)}}
      {0 1 0}
      {{-sin(rotateY*pi/180)} 0 {cos(rotateY*pi/180)}}
    }
  name rotateY1
  xpos 334
  ypos 289
  addUserKnob {20 User}
  addUserKnob {1 a}
  a cos(rotateY*pi/180)
  addUserKnob {1 b}
  b 0
  addUserKnob {1 c}
  c sin(rotateY*pi/180)
  addUserKnob {1 d}
  d 0
  addUserKnob {1 e}
  e 1
  addUserKnob {1 f}
  f 0
  addUserKnob {1 g}
  g -sin(rotateY*pi/180)
  addUserKnob {1 h}
  h 0
  addUserKnob {1 i}
  i cos(rotateY*pi/180)
 }
