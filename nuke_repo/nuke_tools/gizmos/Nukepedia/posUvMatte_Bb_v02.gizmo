
Gizmo {
 inputs 3
 help "Extracts shapes from 3D passes and moves them with your objects, tracking the UV pass.\n(built upon the 3DMattes  Gizmo by Pau Rocher : bikura@gmail.com)\n\n\nFeed it with a position and a UV pass through the \"in\" input, and select the right channel for them.\n\nUse the \"alt pos\" input to create you shape selection on a second position pass.\n\nUse the \"mask_uv\" input to specify an object to work on (or it will use the first matching uv ccords from down left corner)\n\n\nUse \"side by side\" mode to pick a UV value AND see the resulting mask at the same time.\n\n\n\nUV mode :\n\nuse UV threshold to be sur you always get a matching selection (check show selection to check the range)\n\nuse the Offset U and V values to animate to animate the UV position (can be useful if part of your object gets occulted) or to select the right UV tile.\n\n\nUse the 3D OFFSET to offset the resulting 3D position\n\n\nHave fun !\n\n\n\nby bflat (Bastien Brenot)\nmail@bastienbrenot.com\n\n\n\n"
 tile_color 0xff9fff
 addUserKnob {20 POSmask l "POS mask"}
 addUserKnob {41 pointPass l "point pass" t "Layer selected will be used to extract the shapes.\nUsually a pointPass, xyzCamera, xyzWorld or nomalMap." T Shuffle_POSITION_PASS.in}
 addUserKnob {6 useAltPos l "use alt. pos pass" -STARTLINE}
 addUserKnob {41 inUV l "UV pass" T Shuffle_UV.in}
 addUserKnob {26 ""}
 addUserKnob {18 point l "3D point" t "The selected color will be the center for the created shape."}
 point {-100 -1 2}
 addUserKnob {6 point_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {18 UVpicker l "UV coord"}
 UVpicker {0.5 0.5 0}
 addUserKnob {6 UVpicker_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {26 ""}
 addUserKnob {4 outputMode l "output :" M {rgb "point pass" "UV pass" "" ""}}
 outputMode "point pass"
 addUserKnob {6 sideBySide l "side by side" -STARTLINE}
 addUserKnob {6 premultByMask l "premult output by mask" -STARTLINE}
 addUserKnob {6 invertMask l invert -STARTLINE}
 addUserKnob {6 maskInRGB l "show mask in RGB" +STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {20 UVgroup l "UV mode" n 1}
 addUserKnob {6 UVenable l "enable UV mode          //               " +STARTLINE}
 addUserKnob {7 uvThreshold l "uv threshold" R 0 0.5}
 uvThreshold 0.05
 addUserKnob {6 showSelection l "show selection" -STARTLINE}
 addUserKnob {30 uvoffset l offset}
 addUserKnob {6 maskUV l mask +STARTLINE}
 addUserKnob {41 maskChannelMask l "" -STARTLINE T Multiply_mask_UV.maskChannelMask}
 addUserKnob {41 inject -STARTLINE T Multiply_mask_UV.inject}
 addUserKnob {41 invert_mask l invert -STARTLINE T Multiply_mask_UV.invert_mask}
 addUserKnob {41 fringe -STARTLINE T Multiply_mask_UV.fringe}
 addUserKnob {26 ""}
 addUserKnob {20 endGroup n -1}
 addUserKnob {13 offset3d l "3d offset"}
 addUserKnob {26 ""}
 addUserKnob {4 shape t "Here you can choose diferent shapes." M {sphere cylinder x y z ""}}
 addUserKnob {7 expansion t "Size of shape." R 0 50}
 expansion 15
 addUserKnob {7 fallof t Fallof.}
 fallof 1
 addUserKnob {26 ""}
 addUserKnob {13 modifyShape l "modify shape" t "Modifies the form of the shape."}
 modifyShape {1 1 1}
 addUserKnob {7 rotateX t "Rotates the shape in the X axis." R -180 180}
 addUserKnob {7 rotateY t "Rotates the shape in the Y axis." R -180 180}
 addUserKnob {7 rotateZ t "Rotates the shape in the Z axis." R -180 180}
 addUserKnob {18 center t "Center of rotation.\nDrag the values from the selected point to put the origin point at the center of the shape."}
 center {0 0 0}
 addUserKnob {6 center_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
}
