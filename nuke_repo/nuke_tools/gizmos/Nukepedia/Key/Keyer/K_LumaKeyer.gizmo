#! /EDI/apps/64_bit/common/opt/Nuke6.0v3/Nuke6.0 -nx
version 6.0 v3
Gizmo {
 help "==========================================\nLumaKeyer v1.03      12_3_10\n==========================================\n\n--channels: wich channels you want to use to keying\n--operation: wich colorspace you want to use HSV, HSL or LAB\n--you can only use the master curve to pull a key. You can add as many point as you wish. Do not use red/green/blu curve for the key\n\n==========================================\n feel free to send me a mail to niccolo.barbero@gmail.com\n=========================================="
 addUserKnob {20 User}
 addUserKnob {41 channels T Remove1.channels}
 addUserKnob {4 operation M {HSV HSL Lab ""}}
 addUserKnob {6 Invert l "invert alpha" +STARTLINE}
 addUserKnob {6 premult l premultiply +STARTLINE}
 addUserKnob {41 lut l "" +STARTLINE T ColorLookup1.lut}
}
 Input {
  inputs 0
  name Img
  xpos -73
  ypos -336
 }
set Ne433c640 [stack 0]
 Remove {
  operation keep
  channels rgb
  name Remove1
  xpos 193
  ypos -343
 }
 AddChannels {
  channels rgb
  name AddChannels1
  xpos 193
  ypos -270
 }
 ColorLookup {
  lut {master {curve C x0.030726403 0 s0 x0.5894590616 0.2865282893 x0.9583829641 1 s2.200000048}
    red {}
    green {}
    blue {}
    alpha {}}
  name ColorLookup1
  selected true
  xpos 193
  ypos -199
 }
set Ne44834d0 [stack 0]
 Colorspace {
  colorspace_out CIE-Lab
  name Colorspace3
  label "\[value colorspace_out]"
  xpos 352
  ypos -149
 }
 Shuffle {
  blue red
  name Shuffle1
  xpos 352
  ypos -92
 }
push $Ne44834d0
 Colorspace {
  colorspace_out HSL
  name Colorspace2
  label "\[value colorspace_out]"
  xpos 193
  ypos -135
 }
push $Ne44834d0
 Colorspace {
  colorspace_out HSV
  name Colorspace1
  label "\[value colorspace_out]"
  xpos 72
  ypos -144
 }
 Switch {
  inputs 3
  which {{parent.operation i}}
  name Switch1
  xpos 193
  ypos -25
 }
push $Ne433c640
 Copy {
  inputs 2
  from0 rgba.blue
  to0 rgba.alpha
  name Copy1
  xpos -73
  ypos 1
 }
 Invert {
  channels alpha
  name Invert1
  xpos -73
  ypos 115
  disable {{!parent.Invert i}}
 }
 Premult {
  name Premult1
  xpos -73
  ypos 242
  disable {{!parent.premult i}}
 }
 Output {
  name Output1
  xpos -73
  ypos 310
 }
end_group
